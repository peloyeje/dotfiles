{
  "lastChangelogVersion": "1.3.0",
  "theme": "dark",
  "steeringMode": "one-at-a-time",
  "enableInstallTelemetry": false,
  "defaultThinkingLevel": "xhigh",
  "defaultProvider": "amazon-bedrock-aip",
  "defaultModel": "claude-opus-5-5[1m]",
  "skills": [
    "~/.pi/agent/git/github.mpi-internal.com/leboncoin/claude-code-plugins/plugins/experimental/source-code-management/skills",
    "~/.pi/agent/git/github.mpi-internal.com/leboncoin/claude-code-plugins/plugins/experimental/backstage/skills",
    "~/.pi/agent/git/github.mpi-internal.com/leboncoin/claude-code-plugins/plugins/experimental/datacli/skills",
    "~/.pi/agent/git/github.mpi-internal.com/leboncoin/claude-code-plugins/plugins/experimental/data-taskforce/skills"
  ],
  "packages": [
    {
      "source": "npm:pi-web-access",
      "skills": [
        "!skills/librarian"
      ]
    },
    "git:github.com/DietrichGebert/ponytail",
    "npm:pi-rtk-optimizer",
    "npm:pi-archimedes",
    "npm:pi-vim",
    "../../repos/jep-pi-extensions",
    "git:git@github.mpi-internal.com:leboncoin/claude-code-plugins"
  ],
  "compaction": {
    "enabled": true
  },
  "doubleEscapeAction": "tree",
  "outputPad": 1,
  "editorPaddingX": 1,
  "showCacheMissNotices": true,
  "collapseChangelog": true,
  "quietStartup": false,
  "defaultProjectTrust": "ask",
  "warnings": {
    "anthropicExtraUsage": true
  },
  "archimedes.mcp": {
    "enabled": false
  },
  "enabledModels": [
    "amazon-bedrock-aip/claude-opus-5-5[1m]",
    "amazon-bedrock-aip/claude-opus-4-8[1m]",
    "amazon-bedrock-aip/claude-sonnet-5-5[1m]",
    "amazon-bedrock-aip/claude-haiku-5-5[1m]",
    "openai-codex/gpt-6-astra",
    "openai-codex/gpt-6.1-sol",
    "openai-codex/gpt-6-luna",
    "openrouter/openrouter/auto",
    "openrouter/z-ai/glm-5.3",
    "openrouter/z-ai/glm-5.3-flash"
  ],
  "hideThinkingBlock": false,
  "cacheWarming": "idle",
  "modelThinkingLevels": {
    "zai/glm-5.3": "max",
    "zai/glm-5.3-flash": "max",
    "openai-codex/gpt-6-astra": "medium",
    "openai-codex/gpt-6-sol": "high",
    "openai-codex/gpt-6-luna": "high",
    "amazon-bedrock-aip/claude-opus-5-5[1m]": "high",
    "amazon-bedrock-aip/claude-sonnet-5[1m]": "xhigh",
    "amazon-bedrock-aip/claude-opus-4-8[1m]": "xhigh"
  },
  "extensions": [
    "-extensions/writing-docs-gate/index.ts"
  ],
  "archimedes.ui": {
    "bashToolStyling": true,
    "codemodeToolStyling": true,
    "mutedTheme": false,
    "autoCollapseThinking": false,
    "thinkingStyle": "Compact",
    "toolStyle": "Minimal",
    "codeUnindent": true,
    "labelText": "Thinking...",
    "labelColor": "255,215,0",
    "animationStyle": "vertical-up",
    "editorSpinBorder": true,
    "editorSpinSpeed": "normal",
    "editorSpinLabel": "Working",
    "editorSpinStyle": "pendulum"
  },
  "archimedes.meta": {
    "onboarded": true
  }
}
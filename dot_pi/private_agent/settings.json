{
  "lastChangelogVersion": "0.87.1",
  "theme": "dark",
  "steeringMode": "one-at-a-time",
  "enableInstallTelemetry": false,
  "defaultThinkingLevel": "xhigh",
  "defaultProvider": "amazon-bedrock-aip",
  "defaultModel": "claude-opus-5-5[1m]",
  "skills": [
    "~/.pi/agent/git/github.mpi-internal.com/leboncoin/claude-code-plugins/plugins/experimental/source-code-management/skills",
    "~/.pi/agent/git/github.mpi-internal.com/leboncoin/claude-code-plugins/plugins/experimental/backstage/skills",
    "~/.pi/agent/git/github.mpi-internal.com/leboncoin/claude-code-plugins/plugins/experimental/datacli/skills",
    "~/.pi/agent/git/github.mpi-internal.com/leboncoin/claude-code-plugins/plugins/experimental/data-taskforce/skills"
  ],
  "packages": [
    {
      "source": "npm:pi-web-access",
      "skills": [
        "!skills/librarian"
      ]
    },
    "git:github.com/DietrichGebert/ponytail",
    "npm:pi-mcp-adapter",
    "npm:pi-rtk-optimizer",
    "npm:pi-archimedes",
    "npm:pi-vim",
    "../../repos/jep-pi-extensions",
    "git:github.mpi-internal.com/leboncoin/claude-code-plugins"
  ],
  "compaction": {
    "enabled": true
  },
  "doubleEscapeAction": "tree",
  "outputPad": 1,
  "editorPaddingX": 1,
  "showCacheMissNotices": true,
  "collapseChangelog": true,
  "quietStartup": false,
  "defaultProjectTrust": "ask",
  "warnings": {
    "anthropicExtraUsage": true
  },
  "archimedes.mcp": {
    "enabled": false
  },
  "enabledModels": [
    "amazon-bedrock-aip/claude-opus-5-5[1m]",
    "amazon-bedrock-aip/claude-opus-4-8[1m]",
    "amazon-bedrock-aip/claude-sonnet-5[1m]",
    "openai-codex/gpt-6-astra",
    "openai-codex/gpt-6-sol",
    "openai-codex/gpt-6-luna",
    "zai/glm-5.3-flash",
    "zai/glm-5.3"
  ],
  "hideThinkingBlock": false,
  "cacheWarming": "idle",
  "modelThinkingLevels": {
    "zai/glm-5.3": "max",
    "zai/glm-5.3-flash": "max",
    "openai-codex/gpt-6-astra": "medium",
    "openai-codex/gpt-6-sol": "high",
    "openai-codex/gpt-6-luna": "high",
    "amazon-bedrock-aip/claude-opus-5-5[1m]": "high",
    "amazon-bedrock-aip/claude-sonnet-5[1m]": "xhigh",
    "amazon-bedrock-aip/claude-opus-4-8[1m]": "xhigh"
  },
  "extensions": [
    "-extensions/writing-docs-gate/index.ts"
  ]
}

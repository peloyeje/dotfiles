{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "awsAuthRefresh": "aws sso login --profile {{ .claude_aws_profile }}",
  "env": {
    "AWS_PROFILE": "{{ .claude_aws_profile }}",
    "AWS_REGION": "{{ .claude_aws_region }}",
    "_comment_ENABLE_TOOL_SEARCH": "Force MCP tool-search deferral: only tool NAMES load at session start, full JSON schemas load on demand via ToolSearch. Keeps ~200 MCP tool schemas out of context until needed. Values: true=force defer, auto=defer only if schemas exceed 10% of context, false=load all upfront.",
    "ENABLE_TOOL_SEARCH": "true"
  },
  "permissions": {
    "allow": [
      "Bash(rtk git *)",
      "Bash(rtk ls*)",
      "Bash(rtk grep*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr edit --body:*)",
      "Bash(gh pr view:*)",
      "Bash(kubectl get:*)",
      "Bash(kubectl config current-context)",
      "Bash(kubectl config set-context:*)",
      "Bash(helm list:*)",
      "Bash(pre-commit run)",
      "Bash(kubectl describe:*)"
    ],
    "deny": []
  },
  "model": "sonnet[1m]",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "rtk hook claude"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "feature-dev@claude-code-plugins": true,
    "context7-plugin@context7-marketplace": true,
    "code-review@claude-code-plugins": true,
    "pr-review-toolkit@claude-code-plugins": true,
    "document-skills@anthropic-agent-skills": true,
    "example-skills@anthropic-agent-skills": true,
    "chrome-devtools-mcp@chrome-devtools-plugins": true,
    "caveman@caveman": true,
    "superpowers@superpowers-marketplace": true,
    "backstage@leboncoin-claude-code-plugins": true,
    "slack@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "astral@astral-sh": true,
    "cicd@leboncoin-claude-code-plugins": true,
    "ponytail@ponytail": true,
    "gerrit@leboncoin-claude-code-plugins": true,
    "source-code-management@leboncoin-claude-code-plugins": true
  },
  "extraKnownMarketplaces": {
    "anthropic-agent-skills": {
      "source": {
        "source": "github",
        "repo": "anthropics/skills"
      }
    },
    "chrome-devtools-plugins": {
      "source": {
        "source": "github",
        "repo": "ChromeDevTools/chrome-devtools-mcp"
      }
    },
    "caveman": {
      "source": {
        "source": "github",
        "repo": "JuliusBrussee/caveman"
      }
    },
    "superpowers-marketplace": {
      "source": {
        "source": "github",
        "repo": "obra/superpowers-marketplace"
      }
    },
    "leboncoin-claude-code-plugins": {
      "source": {
        "source": "git",
        "url": "git@github.mpi-internal.com:leboncoin/claude-code-plugins.git"
      }
    },
    "astral-sh": {
      "source": {
        "source": "github",
        "repo": "astral-sh/claude-code-plugins"
      }
    },
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    }
  },
  "effortLevel": "xhigh",
  "autoUpdatesChannel": "stable",
  "editorMode": "vim",
  "preferredNotifChannel": "terminal_bell",
  "autoCompactEnabled": false
}
